    {
      "key": "tenis_id",
      "value": "1"
    },
    {
      "key": "nuevo_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Autenticación",
      "item": [
        {
          "name": "Registrar usuario",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/register/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "register"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"jonathan\",\n  \"email\": \"jonathan@correo.com\",\n  \"password\": \"MiClave2026\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Login cliente (guarda token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api-token-auth/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api-token-auth"
              ]
            },
            "description": "Para probar como usuario normal: crear o editar responde 403 y el inventario no es visible.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"cliente\",\n  \"password\": \"Cliente12345\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json();",
                  "if (d.token) { pm.collectionVariables.set('token', d.token); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Mi perfil",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/me/",
              "host": [
